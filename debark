"""DebArk command entry point."""

from __future__ import annotations

import sys

# Python prepends the command's directory to sys.path. Remove it before
# importing the standard library so unrelated scripts beside this launcher
# cannot shadow modules such as ``token``.
if sys.path:
    sys.path.pop(0)

from pathlib import Path


def _load_project_package() -> None:
    executable = Path(__file__).resolve()
    candidates = (
        executable.parent / "src",
        executable.parent.parent / "lib",
    )
    for root in candidates:
        if (root / "debark" / "__init__.py").is_file():
            sys.path.insert(0, str(root))
            return
    raise SystemExit("debark: could not locate the DebArk Python package.")


_load_project_package()

_apt_tool = Path(sys.argv[0]).name
if _apt_tool in {"apt", "apt-get", "apt-cache", "dpkg"}:
    _invoked_arguments = sys.argv[1:]
    sys.argv[0] = str(Path(sys.argv[0]).resolve())
    sys.argv[1:] = ["apt-compat", _apt_tool, *_invoked_arguments]

from debark.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
